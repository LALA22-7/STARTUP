# ============================================================
# ClinicOS Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Database (required)
# PostgreSQL connection string used by SQLAlchemy async engine.
# Format: postgresql+asyncpg://user:password@host:port/dbname
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/clinicos

# ------------------------------------------------------------
# Meta WhatsApp Business API (required)
# Obtain these from the Meta Developer Portal:
# https://developers.facebook.com/apps/
#
# META_PHONE_ID      — The numeric Phone Number ID for your
#                      WhatsApp Business number.
# META_ACCESS_TOKEN  — Permanent or temporary access token
#                      with whatsapp_business_messaging permission.
# META_VERIFY_TOKEN  — A secret string you choose; must match
#                      the value entered in the Meta webhook config.
# ------------------------------------------------------------
META_PHONE_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# ------------------------------------------------------------
# AI / LLM Keys (required for the AI agent swarm)
# GROQ_API_KEY   — Used by the six-agent swarm (Triage, Booking,
#                  Sentiment, Clinical, Webhook, Orchestrator)
#                  via the Groq OpenAI-compatible API.
# GEMINI_API_KEY — Used for Gemini-based AI features.
# ------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------
# Twilio IVR / Auto-Callback (optional)
# If these are not set, IVR calls are skipped and a warning
# is logged. WhatsApp reminders still work without Twilio.
#
# TWILIO_ACCOUNT_SID  — Found in the Twilio Console dashboard.
# TWILIO_AUTH_TOKEN   — Found in the Twilio Console dashboard.
# TWILIO_PHONE_NUMBER — Your Twilio phone number in E.164 format
#                       (e.g. +12025551234).
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------
# Google Calendar Integration (optional)
# Two options — use one or the other:
#
# GOOGLE_CREDENTIALS_JSON — Full JSON content of the service account
#                           key file as a single-line string.
#                           Recommended for cloud deployments (Render,
#                           Railway) where you can't upload files.
#                           Paste the entire contents of your
#                           google_credentials.json here.
#
# GOOGLE_CREDENTIALS_FILE — Path to the credentials JSON file on disk.
#                           Use this for local development or Docker.
#                           GOOGLE_CREDENTIALS_JSON takes priority if
#                           both are set.
# ------------------------------------------------------------
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=/backend/google_credentials.json

# ------------------------------------------------------------
# Frontend (Next.js)
# Base URL of the backend API, consumed by the React frontend.
# In production, replace with your deployed backend URL.
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
